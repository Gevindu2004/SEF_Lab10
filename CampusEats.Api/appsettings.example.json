{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=your-db-host;Database=your-db-name;Username=your-username;Password=your-password;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Key": "your-256-bit-secret-key-here",
    "Issuer": "CampusEats",
    "Audience": "CampusEatsUsers"
  },
  "Supabase": {
    "Url": "https://your-project.supabase.co",
    "PublishableKey": "your-supabase-publishable-key"
  }
}
